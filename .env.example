# =============================================================
#  Packaging Compliance AI - PPWR MVP
#  Skopiuj do .env i uzupelnij realnymi wartosciami.
#  .env jest w .gitignore i NIGDY nie trafia do repo.
# =============================================================

# --- LLM (Anthropic) ---
# Klucz z https://console.anthropic.com  (ustaw tam limit zuzycia / spend cap!)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Model potwierdzimy w Fazie 11; domyslnie tanszy/szybki do RAG:
ANTHROPIC_MODEL=claude-sonnet-5

# --- Embeddings (provider ustalany w Fazie 7) ---
# Wariant A (rekomendowany): Voyage AI - darmowy tier pokrywa jeden akt prawny
# VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxx
# EMBEDDING_MODEL=voyage-3.5
# Wariant B (fallback): lokalny model multilingual - bez klucza

# --- Access gate (hosting: Streamlit + haslo aplikacji) ---
# Jedno wspolne haslo do MVP. Na produkcji ustawiane przez sekret hostingu.
APP_PASSWORD=zmien-to-haslo

# --- Tryb deweloperski (ukryte panele debug w UI) ---
DEBUG_MODE=false

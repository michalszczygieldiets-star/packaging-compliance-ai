# =============================================================
#  Packaging Compliance AI - PPWR MVP
#  Skopiuj do .env i uzupelnij realnymi wartosciami.
#  .env jest w .gitignore i NIGDY nie trafia do repo.
# =============================================================

# --- LLM (Anthropic) ---
# Klucz z https://console.anthropic.com  (ustaw tam limit zuzycia / spend cap!)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Model: opus-5 = najlepsza poprawnosc prawna. Dla nizszego kosztu mozesz
# wpisac claude-sonnet-5 (tez bardzo dobry do tego RAG).
ANTHROPIC_MODEL=claude-opus-5

# --- Embeddings ---
# Lokalne, keyless (paraphrase-multilingual-MiniLM-L12-v2). Nic nie trzeba ustawiac.

# --- Access gate (hosting: Streamlit + haslo aplikacji) ---
# Jedno wspolne haslo do MVP. Na produkcji ustawiane przez sekret hostingu.
APP_PASSWORD=zmien-to-haslo

# --- Tryb deweloperski (ukryte panele debug w UI) ---
DEBUG_MODE=false
